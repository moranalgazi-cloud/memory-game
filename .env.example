# Optional: cross-device admin + stats backup via Supabase (https://supabase.com).
# Create a project, run supabase/memory_players.sql in the SQL editor, then fill the two lines below.
# Leave empty to keep everything local-only (current default).
#
# VITE_SUPABASE_URL — Project Settings → General (or API): https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY — Project Settings → API Keys:
#   Prefer the new "Publishable" default key (sb_publishable_...), OR the "Legacy" tab → anon public (eyJ...).
#   Do NOT use the "secret" / service_role key in the frontend.
#
# Google sign-in: Supabase → Authentication → URL Configuration must include your app URL
# (e.g. https://www.playmemorygames.win/) in Redirect URLs and as Site URL.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Cloudflare Worker that returns short-lived TURN credentials (Phase 4).
# Production: https://www.playmemorygames.win/api/turn-credentials
# Leave empty for STUN-only (works on same Wi‑Fi; may fail on mobile data).
VITE_TURN_CREDENTIALS_URL=

# Android ads (AdMob) — off by default on web and local dev.
# Set VITE_ADS_ENABLED=true in a production Android build (.env.production).
# Create units in AdMob → Apps → Memory games → Ad units (interstitial).
# Use child-directed / Families settings in AdMob and Play Console.
VITE_ADS_ENABLED=
VITE_ADS_USE_TEST_UNITS=true
VITE_ADMOB_INTERSTITIAL_ID=
VITE_ADMOB_REWARDED_ID=
# Show a full-screen ad after this many solo wins (default 2).
VITE_ADS_GAMES_BETWEEN=2
